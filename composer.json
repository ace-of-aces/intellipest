{
    "name": "ace-of-aces/intellipest",
    "description": "Generate IDE helpers to assist development with PestPHP",
    "authors": [
        {
            "name": "Julian Schramm",
            "email": "hi@julian.center"
        }
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "type": "library",
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.4.0 || ^8.0.0",
        "nikic/php-parser": "^5.7",
        "react/event-loop": "^1.6"
    },
    "require-dev": {
        "pestphp/pest": "^4.3",
        "laravel/pint": "^1.29",
        "carthage-software/mago": "^1.26.0"
    },
    "autoload": {
        "psr-4": {
            "AceOfAces\\IntelliPest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/intellipest"
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "analyze": "mago analyze",
        "format": "mago fmt",
        "format:check": "mago fmt --check",
        "lint": "mago lint",
        "test": "pest",
        "test:all": [
            "@format:check",
            "@lint",
            "@test",
            "@analyze"
        ],
        "test:update-fixtures": "./tests/bin/update-fixtures"
    }
}
